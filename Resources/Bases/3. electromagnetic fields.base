views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("3. Electromagnetic Fields")
    order:
      - confidence
      - file.name
      - file.folder
    sort:
      - property: confidence
        direction: ASC
      - property: file.folder
        direction: ASC
    columnSize:
      note.confidence: 48
