summaries:
  Unique: values.unique().length
  Filled: values.filter(!value.isType("null")).length
views:
  - type: table
    name: View
    filters:
      or:
        - file.inFolder("1. Mathematics")
        - file.inFolder("2. Electric Circuits")
        - file.inFolder("3. Electromagnetic Fields")
        - file.inFolder("4. Signal & Systems")
        - file.inFolder("5. Electrical Machines")
        - file.inFolder("6. Power System")
        - file.inFolder("7. Control Systems")
        - file.inFolder("8. Electrical and Electronic Measurements")
        - file.inFolder("9. Analog & Digital Electronics")
        - file.inFolder("10. Power Electronics")
    order:
      - file.name
      - file.folder
    sort:
      - property: file.folder
        direction: ASC
      - property: file.tags
        direction: DESC
    summaries:
      file.name: Empty
