{
  "_help": "exclude: folders/files never published. hide: notes that can still be linked and embedded (e.g. question papers) but are not listed in the file tree or search. Paths are relative to the repository root.",
  "exclude": [".git", ".github", ".obsidian", ".trash", "node_modules", "web-script"],
  "excludeFiles": ["README.md"],
  "hide": ["Resources/Question Paper", "VAULT_SPEC.md","VAULT_RULES_SPEC.md","UPDATE_POLICY.md","SPEC.md","INSTALL_PLAN_SPEC.md","INDEX_SPEC.md","INDEX_GENERATOR_SPEC.md","GATE Simulator.md","CONTRIBUTING.md","CONTRIBUTE.md","CODE_OF_CONDUCT.md"],
  "attachmentExtensions": ["png", "jpg", "jpeg", "gif", "svg", "webp", "avif", "bmp", "pdf", "mp3", "wav", "ogg", "m4a", "mp4", "webm"],
  "output": "notes-index.json",
  "searchOutput": "notes-search.json",
  "excerptLength": 200,
  "searchTextLimit": 20000
}
